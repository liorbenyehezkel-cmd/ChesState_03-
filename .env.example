# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional and server-only. Never put a secret / service-role key in NEXT_PUBLIC_*.
# Data collection uses the publishable key; this is only for Auth admin tasks.
# SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Used to build the email-confirmation redirect for entrepreneur signups.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
